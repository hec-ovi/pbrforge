    "node",
    "scripts/author-interior-floors.mjs",
    "--prepare-only"
  ],
  "prepareExplanation": "Run from the materials checkout. Reconstructs full coordinated maps from preserved sources, writes portable batch requests and runtime requests with absolute sourceMaps resolved inside that checkout. Preparation does not write the theme. Source minimum1024px; refuse upscaling.",
