    "node",
    "scripts/author-interior-floors.mjs"
  ],
  "preferredImportExplanation": "Prepares then invokes public create --native and resolve for each entry, with explicit checkout themes and runtime absolute sourceMaps. Existing entries are refused unless --replace is explicitly passed.",
