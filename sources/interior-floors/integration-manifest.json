    "npm",
    "run",
    "compress",
    "--",
    "--keys",
    "batch/cyberpunk/interior-floors/keys.json",
    "--workers",
    "1",
    "--max-temp",
    "80"
  ],
  "compressionNote": "Run the compression CLI built inside the target checkout so its theme root is the target. KTX2 build outputs are ignored by git and need copying/rebuilding at integration.",
