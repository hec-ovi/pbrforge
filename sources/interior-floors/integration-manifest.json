    "node",
    "${PBRFORGE_CLI}"
  ],
  "defaultPbrforgeCli": "${MATERIALS_REPO}/dist/cli/pbrforge.js",
  "safety": "Always pass the explicit isolated --themes argument, including when PBRFORGE_CLI points to a build in another checkout. No existing catalog entries need modification.",
