{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:material-entry",
  "title": "MaterialEntry",
  "type": "object",
  "required": ["key", "alignment", "physical", "variants"],
  "additionalProperties": false,
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+/[a-z0-9_-]+$",
      "description": "theme/kind/tier, lowercase slugs"
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+/[a-z0-9_-]+$" },
      "default": []
    },
    "alignment": { "enum": ["tile", "exact"] },
    "tiling": {
      "type": "object",
      "description": "required when alignment is tile: meters covered by one tile repeat; 1 UV unit = 1 tile",
      "required": ["worldSize"],
      "additionalProperties": false,
      "properties": {
        "worldSize": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 2,
          "maxItems": 2,
          "description": "[width, height] in meters"
        }
      }
    },
    "aspect": {
      "type": "array",
      "items": { "type": "number", "exclusiveMinimum": 0 },
      "minItems": 2,
      "maxItems": 2,
      "description": "required when alignment is exact: [w, h] aspect ratio of the placement face"
    },
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "breakable": { "type": "boolean", "default": false },
        "metallicFactor": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "roughnessFactor": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "transmission": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "ior": { "type": "number", "minimum": 1, "default": 1.5 },
        "tint": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$",
          "description": "attenuation color for transmissive materials"
        },
        "emissiveStrength": { "type": "number", "minimum": 0, "default": 1 },
        "alphaMode": { "enum": ["OPAQUE", "BLEND", "MASK"], "default": "OPAQUE" }
      }
    },
    "finish": {
      "$comment": "written on entries with photographed variants; a pattern and a screen carry their own maps",
      "type": "object",
      "required": ["roughness", "grain", "relief"],
      "additionalProperties": false,
      "properties": {
        "roughness": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "minItems": 2,
          "maxItems": 2,
          "description": "[min, max] band the roughness map stays inside"
        },
        "grain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "how much of the pixel-scale speckle survives into the relief"
        },
        "relief": { "type": "number", "minimum": 0, "maximum": 4, "description": "gain on the feature-scale relief" }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "description": "variant 0 is canonical; consumers may pick by seed",
      "items": {
        "type": "object",
        "required": ["id", "resolution", "maps"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+(:[a-z0-9_-]+)?$",
            "description": "a slug, or a namespaced one: brand:<slug> is a rebranded screen"
          },
          "class": {
            "enum": ["image", "pattern", "flat"],
            "default": "image",
            "description": "how the maps were made: image source, drawn pattern, or synthesized flat field; consumers read them the same way"
          },
          "resolution": {
            "type": "array",
            "items": { "type": "integer", "minimum": 64, "maximum": 4096 },
            "minItems": 2,
            "maxItems": 2,
            "description": "[px width, px height], shared by every map of the variant"
          },
          "maps": {
            "type": "object",
            "required": ["basecolor", "normal", "roughness", "metallic"],
            "additionalProperties": false,
            "properties": {
              "basecolor": { "$ref": "#/$defs/mapPath" },
              "normal": { "$ref": "#/$defs/mapPath" },
              "roughness": { "$ref": "#/$defs/mapPath" },
              "metallic": { "$ref": "#/$defs/mapPath" },
              "height": { "$ref": "#/$defs/mapPath" },
              "ao": { "$ref": "#/$defs/mapPath" },
              "emission": { "$ref": "#/$defs/mapPath" }
            }
          },
          "screen": {
            "type": "object",
            "description": "on a screen variant painted by the create lane: the display it is shown on and the brandless picture behind its emission, which a rebrand re-composites text over",
            "required": ["kind", "artwork"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["led-dot", "scanline-billboard", "glyph-panel"] },
              "pitch": { "type": "integer", "minimum": 2 },
              "artwork": { "$ref": "#/$defs/mapPath" }
            }
          },
          "layout": {
            "$ref": "#/$defs/surfaceLayout"
          }
        }
      }
    }
  },
  "$defs": {
    "surfaceLayout": {
      "type": "object",
      "description": "visible surface divisions in world metres; fine grain remains independent",
      "required": ["family", "origin", "orientation"],
      "additionalProperties": false,
      "properties": {
        "family": { "enum": ["continuous", "panel", "band", "lane"] },
        "moduleSize": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 2,
          "maxItems": 2,
          "description": "visible [width, height] in metres"
        },
        "jointWidth": { "type": "number", "minimum": 0, "description": "visible joint width in metres" },
        "origin": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "stable world-space [x, y] grid origin in metres"
        },
        "orientation": { "enum": ["horizontal", "vertical", "isotropic"] },
        "bandHeight": { "type": "number", "exclusiveMinimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "family": { "const": "panel" } } },
          "then": { "required": ["moduleSize", "jointWidth"] }
        },
        {
          "if": { "properties": { "family": { "const": "band" } } },
          "then": { "required": ["bandHeight"] }
        }
      ]
    },
    "mapPath": {
      "type": "string",
      "pattern": "^assets/[a-z0-9_/-]+\\.png$",
      "description": "path relative to the theme folder"
    }
  }
}
